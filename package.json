{
  "name": "vroid-super-converter",
  "productName": "VRoid Super Converter",
  "version": "0.1.0",
  "description": "Convert any bipedal model or animation to the VRoid skeleton, with a 3D preview, fitting, pose export, lip sync, IK, rig conversion and Project DIVA .farc merging.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs --minify",
    "start": "npm run build && electron .",
    "test": "node --test \"test/**/*.test.mjs\"",
    "dist:win": "npm run build && electron-builder --win portable nsis --x64 --publish never",
    "dist": "npm run build && electron-builder",
    "smoke": "node scripts/build.mjs && node scripts/make-fixtures.mjs .smoke/fixtures && node scripts/smoke.mjs .smoke/fixtures .smoke/shots"
  },
  "build": {
    "appId": "com.vroidsuperconverter.app",
    "productName": "VRoid Super Converter",
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "asar": true
  },
  "devDependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@xmldom/xmldom": "^0.9.12",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.3",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.16"
  },
  "private": true
}
